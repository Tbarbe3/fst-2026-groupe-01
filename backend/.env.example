# Copier en .env : `cp .env.example .env`, puis remplir les valeurs.
# Le .env réel est ignoré par git, ne le commitez jamais.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://codehow:codehow@localhost:5432/codehow

# Brique IA : générateur de scénario + juge évaluateur (Gemini 2.5 Flash)
GEMINI_API_KEY=

# Origine du front en dev (Vite)
CORS_ORIGIN=http://localhost:5173
