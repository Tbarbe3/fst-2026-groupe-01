# Variables de l'API lancée en NATIF (`npm run dev`), via --env-file.
# Copier en .env : `cp .env.example .env`.
#
# Ce fichier ne sert qu'en développement. En production, le conteneur reçoit
# ses variables du bloc `environment:` de docker-compose.yml, alimenté par le
# .env de la racine — celui-ci n'est même pas copié dans l'image.
#
# Le .env réel est ignoré par git, ne le commitez jamais.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL — l'équipe partage la base du VPS, il n'y a pas de base locale.
# On l'atteint par un tunnel SSH ouvert dans un autre terminal :
#
#     ssh -N -L 5432:localhost:5432 dbtunnel@thomasbarbe-server
#
# Le tunnel rend la base distante accessible sur localhost:5432, d'où une
# URL identique à une base locale. Le mot de passe est en revanche celui du
# .env du SERVEUR (POSTGRES_PASSWORD), pas la valeur d'exemple.
#
# Pour travailler hors ligne ou tester une migration risquée sans toucher
# aux données de l'équipe : `docker compose --profile dev up -d` démarre une
# base locale jetable, avec les identifiants du .env de la racine.
DATABASE_URL=postgresql://codehow:MOT_DE_PASSE_DU_SERVEUR@localhost:5432/codehow

# Brique IA : générateur de scénario + juge évaluateur (Gemini 2.5 Flash).
# Optionnelle tant que la brique IA n'est pas implémentée : l'API démarre
# sans elle en émettant un avertissement (cf. src/config/env.ts).
GEMINI_API_KEY=

# Origine du front en dev (Vite)
CORS_ORIGIN=http://localhost:5173
