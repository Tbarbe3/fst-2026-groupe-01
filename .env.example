# Variables lues par docker-compose.yml, en développement comme en production.
# À faire une fois après le clone : `cp .env.example .env`
# Le .env est ignoré par git — les secrets ne doivent jamais y retourner.

# --- PostgreSQL (les deux profils) --------------------------------------
# En dev, ces valeurs faibles conviennent : la base n'écoute que sur la
# loopback. En prod, générer un vrai mot de passe :  openssl rand -base64 32
POSTGRES_USER=codehow
POSTGRES_PASSWORD=codehow
POSTGRES_DB=codehow

# --- Profil `prod` uniquement -------------------------------------------
# Domaine servi par Traefik (doit pointer sur le VPS en DNS).
# Laisser tel quel en dev, ces variables n'y sont pas utilisées.
DOMAIN=codehow.thomasbarbe.com

# Brique IA : générateur de scénario + juge évaluateur (Gemini 2.5 Flash)
GEMINI_API_KEY=

# --- Adminer ------------------------------------------------------------
# Sous-domaine de la console d'administration de la base. Il lui faut son
# propre enregistrement DNS A vers le VPS, sinon Let's Encrypt échoue.
ADMINER_DOMAIN=db.codehow.thomasbarbe.com

# BasicAuth Traefik : c'est la seule chose entre Internet et la page de
# login d'Adminer. Générer la paire login / hash bcrypt avec :
#
#     htpasswd -nbB thomas 'un-mot-de-passe-solide'
#
# (paquet apache2-utils, ou : docker run --rm httpd:alpine htpasswd -nbB thomas 'mdp')
#
# Coller la sortie complète telle quelle, de la forme  thomas:$2y$05$xxxxx
# NE PAS doubler les `$` : ici c'est une valeur de variable, Compose ne
# l'interpole pas. Le doublage ne serait nécessaire que dans un label écrit
# en dur dans docker-compose.yml.
#
# Plusieurs comptes : les séparer par des virgules.
ADMINER_BASIC_AUTH=
