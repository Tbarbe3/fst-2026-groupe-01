# Variables lues par docker-compose.yml, en développement comme en production.
# À faire une fois après le clone : `cp .env.example .env`
# Le .env est ignoré par git — les secrets ne doivent jamais y retourner.

# --- PostgreSQL (les deux profils) --------------------------------------
# En dev, ces valeurs faibles conviennent : la base n'écoute que sur la
# loopback. En prod, générer un vrai mot de passe :  openssl rand -base64 32
POSTGRES_USER=codehow
POSTGRES_PASSWORD=codehow
POSTGRES_DB=codehow

# --- Profil `prod` uniquement -------------------------------------------
# Domaine servi par Traefik (doit pointer sur le VPS en DNS).
# Laisser tel quel en dev, ces variables n'y sont pas utilisées.
DOMAIN=codehow.thomasbarbe.com

# --- Authentification (Better Auth) -------------------------------------
# Clé de signature des sessions. OBLIGATOIRE en production : l'API refuse
# de démarrer sans elle, parce qu'un secret par défaut rend les cookies de
# session falsifiables. Générer :
#
#     openssl rand -hex 32
#
# La changer invalide toutes les sessions en cours — les utilisateurs
# devront se reconnecter.
BETTER_AUTH_SECRET=

# --- Brique IA -----------------------------------------------------------
# Clé Gemini (https://aistudio.google.com/apikey). Vide : l'API tourne en
# mode simulé, sans IA ni coût. AI_MODE=mock force ce mode malgré la clé.
GEMINI_API_KEY=
AI_MODE=
# Modèles Gemini (vides : gemini-3.5-flash-lite). Liste possible, essayée
# dans l'ordre si Google renvoie une erreur (saturé, retiré, quota) :
#   GEMINI_MODEL_JUDGE=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_MODEL_GENERATOR=
GEMINI_MODEL_JUDGE=
# Réflexion des modèles Gemini 3 (vide : low ; minimal n'existe pas sur tous les modèles). « off »
# n'envoie aucun réglage, pour un modèle qui le refuserait (erreur 400).
GEMINI_THINKING_LEVEL=

# --- Adminer ------------------------------------------------------------
# Sous-domaine de la console d'administration de la base. Il lui faut son
# propre enregistrement DNS A vers le VPS, sinon Let's Encrypt échoue.
ADMINER_DOMAIN=db.codehow.thomasbarbe.com

# BasicAuth Traefik : c'est la seule chose entre Internet et la page de
# login d'Adminer. Générer la paire login / hash bcrypt avec :
#
#     htpasswd -nbB thomas 'un-mot-de-passe-solide'
#
# (paquet apache2-utils, ou : docker run --rm httpd:alpine htpasswd -nbB thomas 'mdp')
#
# IMPORTANT : doubler chaque `$` du hash en `$$` avant de coller.
# Compose interpole les valeurs lues ici, et prendrait `$dNV03...` pour une
# variable à remplacer par du vide — le hash arriverait tronqué à Traefik.
#
#   htpasswd donne :  thomas:$2y$05$dNV03...
#   on écrit ici   :  thomas:$$2y$$05$$dNV03...
#
# Plusieurs comptes : les séparer par des virgules.
ADMINER_BASIC_AUTH=
